PORT=8080
ENV=development

DATABASE_URL=postgres://wingback:wingback@localhost:5432/wingback?sslmode=disable
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

JWT_SECRET=change-me-in-production

# Base carrier speed in km/h (default free carrier: pigeon)
DEFAULT_CARRIER_SPEED_KMH=177

# Probability (0.0-1.0) that a message is "lost" in transit
MESSAGE_LOSS_PROBABILITY=0.002

# Ad reward: percentage of remaining ETA skipped per rewarded ad watch
AD_SPEEDUP_PERCENT=50
AD_SPEEDUP_MAX_PER_DAY=3
